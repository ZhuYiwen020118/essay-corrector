<view class="container">
  <view class="card user-card">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar-img" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill" wx:if="{{userInfo.avatar}}"/>
      <view class="avatar-placeholder" wx:else>+</view>
    </button>
    <view class="user-info">
      <input class="nickname-input" type="nickname" placeholder="点击设置昵称" value="{{userInfo.nickname}}" bindblur="onNicknameBlur" />
      <view class="membership-badge {{membership}}">{{membershipLabel}}</view>
    </view>
  </view>

  <view class="card stats-card">
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-value">{{remainingUsage}}</text>
        <text class="stat-label">今日剩余</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{dailyUsage}}</text>
        <text class="stat-label">今日已用</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{totalEssays}}</text>
        <text class="stat-label">累计批改</text>
      </view>
    </view>
  </view>

  <view class="card menu-card">
    <view class="menu-item" bindtap="onViewProgress">
      <text>进步追踪</text>
      <text class="menu-arrow"></text>
    </view>
    <view class="menu-item" bindtap="onViewReference">
      <text>范文库</text>
      <text class="menu-arrow"></text>
    </view>
    <view class="menu-item" bindtap="onViewPrivacy">
      <text>隐私政策</text>
      <text class="menu-arrow"></text>
    </view>
    <view class="menu-item" bindtap="onFeedback">
      <text>意见反馈</text>
      <text class="menu-arrow"></text>
    </view>
    <view class="menu-item" bindtap="onAbout">
      <text>关于我们</text>
      <text class="menu-arrow"></text>
    </view>
  </view>

  <view class="version-text">AI 作文批改 v1.0.0</view>
</view>
